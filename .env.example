# Gemini API Key: https://aistudio.google.com/apikey (app works offline with zero-hallucination deterministic rules if unset)
GEMINI_API_KEY=
# Default: gemini-2.5-flash | Next-gen / preview: gemini-4-hydrogen
GEMINI_MODEL=gemini-2.5-flash
# At least 32 random characters (openssl rand -hex 32); required in production. Signs Skill Passports so they can't be edited after issue.
PASSPORT_SECRET=

# Used automatically when the primary model is overloaded (HTTP 429/5xx)
GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest
