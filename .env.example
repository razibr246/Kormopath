# Free key: https://aistudio.google.com/apikey  (app works without it in rule-based mode)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# At least 32 random characters (openssl rand -hex 32); required in production. Signs Skill Passports so they can't be edited after issue.
PASSPORT_SECRET=

# Used automatically when the primary model is overloaded (HTTP 429/5xx)
GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest
