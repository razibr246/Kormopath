# Copy to .env.local and fill in. Never commit real keys. Every key is optional: without any AI key the app runs on
# its rule-based fallbacks (image/PDF reading, AI voice and web search are then unavailable).

# --- Gemini (https://aistudio.google.com/apikey): text, image/PDF reading, Bangla voice (TTS), Google-grounded search.
# One key, or several comma-separated: requests rotate across the pool, and a refused key is tried last for 30 minutes.
GEMINI_API_KEY=
GEMINI_API_KEYS=
# Optional model overrides (defaults are current models; retired 1.x/2.x names are ignored).
GEMINI_MODEL=
GEMINI_FALLBACK_MODEL=
GEMINI_TTS_MODEL=
GEMINI_TTS_VOICE=Kore

# --- Groq (https://console.groq.com/keys): fastest text answers (about 1 s). Tried first for text; if it has not
# answered within LLM_HEDGE_MS, Gemini starts in parallel and the first valid answer wins.
GROQ_API_KEYS=
GROQ_MODEL=
LLM_HEDGE_MS=1500

# --- OpenRouter (https://openrouter.ai/keys): free models, the last resort when Groq and Gemini both fail.
OPENROUTER_API_KEYS=
OPENROUTER_MODEL=

# --- Tavily (https://app.tavily.com): web search backup when Gemini's search fails or its quota is used up.
TAVILY_API_KEYS=

# --- Passports: at least 32 random characters (openssl rand -hex 32); required in production.
PASSPORT_SECRET=

# --- Optional shared rate limit (Upstash Redis / Vercel KV REST).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
